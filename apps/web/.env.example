WATCHPACK_POLLING=true
IRONCLAW_WEB_ENABLE_MCP_CONNECTORS=0
NEXT_PUBLIC_POSTHOG_KEY=phc_***

# Server-side EnMS DB-first connector.
# Replace all placeholders through deployment secrets and never commit real credentials or customer network details.
ENMS_PG_CONNECTION="host=<ENMS_PG_HOST> port=<ENMS_PG_PORT> dbname=<ENMS_PG_DATABASE> user=<ENMS_PG_USER> password=<secret> sslmode=disable"
ENMS_PG_ALLOWED_HOST="<ENMS_PG_HOST>"
ENMS_PG_ALLOWED_PORT="<ENMS_PG_PORT>"
ENMS_PG_ALLOWED_DATABASE="<ENMS_PG_DATABASE>"

# Server-side Y-CRM / ERP DB-first connectors.
# Replace all placeholders through deployment secrets and never commit real credentials.
YCRM_PG_CONNECTION="dbname=<database> user=<user> password=<secret> host=<host> port=<port>"
ERP_PG_CONNECTION="host=<host> port=<port> dbname=<database> user=<user> password=<secret> sslmode=disable"
