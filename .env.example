export POSTHOG_KEY=phc_***
export NPM_TOKEN=npm_***

# EnMS DB-first connector. Keep real host/user/password in deployment secrets,
# not source code. Never commit real credentials or customer network details.
export ENMS_PG_CONNECTION="host=<ENMS_PG_HOST> port=<ENMS_PG_PORT> dbname=<ENMS_PG_DATABASE> user=<ENMS_PG_USER> password=<secret> sslmode=disable"
export ENMS_PG_ALLOWED_HOST="<ENMS_PG_HOST>"
export ENMS_PG_ALLOWED_PORT="<ENMS_PG_PORT>"
export ENMS_PG_ALLOWED_DATABASE="<ENMS_PG_DATABASE>"
export ENMS_MONGO_URI="mongodb://<ENMS_MONGO_USER>:<secret>@<ENMS_MONGO_HOST>:<ENMS_MONGO_PORT>/<ENMS_MONGO_DATABASE>?authSource=admin"

# EnMS scoped-facts structured model runner. The enms-bff Agent must be
# provisioned in the selected OpenClaw Gateway with tools denied.
export ENCLAW_ENMS_STRUCTURED_AGENT_ENABLED="0"
export ENCLAW_ENMS_STRUCTURED_AGENT_ID="enms-bff"
export ENCLAW_ENMS_PAGE_MODEL_TIMEOUT_MS="30000"
export ENCLAW_ENMS_CHAT_MODEL_TIMEOUT_MS="40000"
# `gateway` 保留既有 OpenClaw Agent 路徑；需穩定 JSON Mode 時可改成
# `openai-compatible`，並由 server-side secret 提供下列設定。
export ENCLAW_ENMS_STRUCTURED_MODEL_TRANSPORT="gateway"
export ENCLAW_ENMS_STRUCTURED_MODEL_BASE_URL="https://<PRIVATE_MODEL_HOST>/v1"
export ENCLAW_ENMS_STRUCTURED_MODEL_API_KEY="<secret>"
export ENCLAW_ENMS_STRUCTURED_MODEL_NAME="<provider-model-id>"
export ENCLAW_ENMS_STRUCTURED_MODEL_MAX_TOKENS="1200"
# Container deployments may create a dedicated keypair in a persistent,
# per-replica OpenClaw state volume. The Gateway must approve it before use.
export OPENCLAW_GATEWAY_AUTO_CREATE_DEVICE_IDENTITY="0"

# EnMS API -> EnClaw server-to-server authentication. Production containers
# should mount a Docker/Kubernetes secret and set only the file path.
export ENCLAW_ENMS_API_KEY_FILE=""
export ENCLAW_ENMS_API_KEY="<server-to-server-secret-for-local-development>"

# Y-CRM / ERP DB-first connectors. Keep real credentials in deployment secrets.
export YCRM_PG_CONNECTION="dbname=<database> user=<user> password=<secret> host=<host> port=<port>"
export ERP_PG_CONNECTION="host=<host> port=<port> dbname=<database> user=<user> password=<secret> sslmode=disable"
