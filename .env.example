export POSTHOG_KEY=phc_***
export NPM_TOKEN=npm_***

# EnMS DB-first connector. Keep the official host/port/dbname and provide the
# password through deployment secrets, not source code. Never commit real credentials.
export ENMS_PG_CONNECTION="host=118.168.188.27 port=55433 dbname=EnMS user=sa password=<secret> sslmode=disable"
export ENMS_MONGO_URI="mongodb://<user>:<secret>@118.168.188.27:27018/enms_mongo?authSource=admin"

# Y-CRM / ERP DB-first connectors. Keep real credentials in deployment secrets.
export YCRM_PG_CONNECTION="dbname=<database> user=<user> password=<secret> host=<host> port=<port>"
export ERP_PG_CONNECTION="host=<host> port=<port> dbname=<database> user=<user> password=<secret> sslmode=disable"
